# Environment configuration for AI Crop Disease Detection System

# Server
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Security & Auth
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Database
# Local SQLite for dev/test: sqlite+aiosqlite:///./backend/app.db
# PostgreSQL for docker/prod: postgresql+asyncpg://postgres:postgres@localhost:5432/crop_disease_db
DATABASE_URL=sqlite+aiosqlite:///./backend/app.db

# Storage
UPLOAD_DIR=./backend/app/static/uploads
MAX_UPLOAD_SIZE_MB=10

# ML Model
MODEL_PATH=./ml/models/efficientnet_b0_plantvillage.onnx
LABELS_PATH=./ml/models/labels.json
MODEL_VERSION_PATH=./ml/models/model_version
CONFIDENCE_THRESHOLD=0.60
UNCERTAIN_ENTROPY_THRESHOLD=2.20

# Weather API (Open-Meteo is free & keyless, with optional rate-limit resilience)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1
WEATHER_CACHE_TTL_SECONDS=1800

# Rate Limiting
RATE_LIMIT_ANALYZE=20/minute
RATE_LIMIT_AUTH=10/minute

# Multilingual Text-To-Speech (TTS)
# Options: 'edge' (Microsoft Neural - default, zero-cost), 'mock' (offline testing), 'azure', 'google'
TTS_PROVIDER=edge
AUDIO_CACHE_DIR=./backend/app/static/audio_cache
# Cloud Provider Keys (Optional: only needed if TTS_PROVIDER is set to 'azure' or 'google')
# AZURE_SPEECH_KEY=your-azure-speech-resource-key
# AZURE_SPEECH_REGION=centralindia
# GOOGLE_APPLICATION_CREDENTIALS=path/to/google_service_account.json
